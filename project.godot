; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LeroyHughes"
run/main_scene="uid://dua0l62dkgrx3"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://vcyfwcsxresj"

[autoload]

SaveManager="*res://scripts/save_manager.gd"
DifficultyManager="*res://scripts/difficulty_manager.gd"
MusicPlayer="*res://scenes/music_player.tscn"
SceneTransition="*res://scripts/scene_transition.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[global_group]

traps=""

